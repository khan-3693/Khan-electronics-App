rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nkae.rjb@gmail.com' ||
        (
          exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true
        )
      );
    }

    // Admin Users Collection
    match /adminUsers/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Customers Collection (Authenticated Customer Profiles)
    match /customers/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      // Public read for customer storefront
      allow read: if true;
      // ONLY authenticated and authorized active admins can modify products
      allow create, update: if isAdmin()
        && isValidId(productId)
        && request.resource.data.productId is string
        && request.resource.data.sellingPrice is number;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Finance Enquiries Collection (0% Interest Finance)
    match /financeEnquiries/{enquiryId} {
      // Browsing/listing all records is restricted to admins or customer's own enquiries
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      // Single enquiry lookup allowed by ID or admin or owning customer
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid) || isValidId(enquiryId);
      // Public customer can submit an enquiry for eligible appliances (>= 30,000 NPR)
      allow create: if isValidId(enquiryId)
        && request.resource.data.enquiryId == enquiryId
        && request.resource.data.fullName is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.email is string
        && request.resource.data.citizenshipNumber is string
        && request.resource.data.productId is string
        && request.resource.data.productPrice is number
        && request.resource.data.productPrice >= 30000
        && request.resource.data.status == 'New';
      // Only administrators can update status or delete
      allow update, delete: if isAdmin();
    }

    // Orders Collection (Showroom Customer Appliance Orders)
    match /orders/{orderId} {
      // Administrators can list all orders; signed-in customers can query their own orders
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      // Single order lookup allowed for administrators, owning customer, or by specific order reference
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid) || isValidId(orderId);
      // Public customer order creation with strict validation
      allow create: if isValidId(orderId)
        && (request.resource.data.orderId == orderId || request.resource.data.id == orderId)
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.orderStatus == 'New'
        && request.resource.data.paymentStatus == 'Unpaid'
        && request.resource.data.paymentMethod in ['Cash on Delivery', 'Pay at Store'];
      // Only authenticated and authorized active administrators can update status, payment or delete
      // Authenticated customers can safely link an unassigned guest order to their own UID
      allow update: if isAdmin() || (
        isSignedIn() &&
        (resource.data.customerId == null || resource.data.customerId == '') &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerId', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Registered Appliance Warranties Collection
    match /warranties/{warrantyId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid) || isValidId(warrantyId);
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /serviceTickets/{ticketId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid) || isValidId(ticketId);
      allow create: if isValidId(ticketId)
        && request.resource.data.id is string
        && request.resource.data.phone is string;
      allow update, delete: if isAdmin();
    }

    match /exchangeRequests/{requestId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid) || isValidId(requestId);
      allow create: if isValidId(requestId)
        && request.resource.data.id is string
        && request.resource.data.phone is string;
      allow update, delete: if isAdmin();
    }

    match /financeApplications/{applicationId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid) || isValidId(applicationId);
      allow create: if isValidId(applicationId)
        && request.resource.data.id is string
        && request.resource.data.citizenshipNo is string;
      allow update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
