rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nkae.rjb@gmail.com'
      );
    }

    // Product images stored at /products/{productId}/{fileName}
    match /products/{productId}/{fileName} {
      // Public customer storefront can read product images
      allow read: if true;
      // Only authenticated and authorized active admin can upload/replace
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024 // 10MB maximum
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      // Only authenticated and authorized active admin can delete
      allow delete: if isAdmin();
    }

    // Customer profile pictures stored at /customers/{userId}/{fileName}
    match /customers/{userId}/{fileName} {
      // Customer can read their own profile picture; authorized admin can also read
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Customer can upload or replace only their own profile picture (max 5MB, valid image format)
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 // 5MB maximum
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      // Customer can remove only their own profile picture
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
